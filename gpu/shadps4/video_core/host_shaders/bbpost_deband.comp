// bbport present-path post pass 1: f3kdb/mpv-style deband plus fog removal, a black-level
// lift, contrast and saturation, with a dithered 8-bit write so smooth gradients survive the
// swapchain. The threshold is in 8-bit levels (libplacebo debands at 4/255 by default); the
// range is the sample radius in pixels. The black lift follows x + lift * (1-x)^2: strongest
// at black, quadratic falloff, highlights untouched. Fog removal is the inverse of an even
// haze of intensity f: out = (x - f) / (1 - f). The source is read through a sampled-image
// descriptor, which per the Vulkan image-read rules returns RGBA-ordered values for BGRA
// formats; the rgba8 store then keeps that order and the final blit does the semantic
// conversion to the swapchain format.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D src_tex;
layout(binding = 1, rgba8) uniform writeonly image2D dst_img;

layout(push_constant) uniform Params {
    vec2 size;       // pixels
    float threshold; // 8-bit levels / 255
    float range;     // sample radius, pixels
    float lift;      // black lift, 0..1
    float defog;     // uniform haze intensity to subtract, 0..0.25
    float contrast;  // mid-grey pivot scale, 1 = neutral
    float saturation; // Rec.709 luma mix, 1 = neutral
    uint seed;       // per-frame RNG seed
    uint split;      // 1: left half passthrough (comparison debug view)
};

uint pcg(inout uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rnd(inout uint state) {
    return float(pcg(state)) / 4294967296.0;
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(size.x) || p.y >= int(size.y)) {
        return;
    }
    uint rng = uint(p.x) * 1973u ^ uint(p.y) * 9277u ^ seed;
    pcg(rng);
    pcg(rng);

    const vec3 c = texelFetch(src_tex, p, 0).rgb;
    // Comparison debug view: the left half is the untouched source pixel.
    if (split == 1u && p.x < int(size.x) / 2) {
        imageStore(dst_img, p, vec4(c, 1.0));
        return;
    }
    // Deband: average with nearby samples whose difference is inside the threshold; three
    // random taps inside the radius, like libplacebo's pl_shader_deband. threshold 0 (no
    // merging) skips the taps, so lift/defog stay usable without debanding.
    vec3 outc = c;
    if (threshold > 0.0) {
        vec3 sum = c;
        float count = 1.0;
        for (int i = 0; i < 3; ++i) {
            const float angle = rnd(rng) * 6.28318530718;
            const float dist = sqrt(rnd(rng)) * range;
            const ivec2 q = clamp(p + ivec2(round(vec2(cos(angle), sin(angle)) * dist)),
                                  ivec2(0), ivec2(size) - 1);
            const vec3 s = texelFetch(src_tex, q, 0).rgb;
            const vec3 diff = abs(s - c);
            if (max(diff.r, max(diff.g, diff.b)) < threshold) {
                sum += s;
                count += 1.0;
            }
        }
        outc = sum / count;
    }
    // Fog removal (levels black-point pull) before the lift, so both stack on clean blacks.
    outc = (outc - defog) / (1.0 - defog);
    outc += lift * (1.0 - outc) * (1.0 - outc);
    // Contrast around mid-grey, then saturation away from Rec.709 luma.
    outc = (outc - 0.5) * contrast + 0.5;
    outc = mix(vec3(dot(outc, vec3(0.2126, 0.7152, 0.0722))), outc, saturation);
    // Triangular dither: two uniforms sum to a +-1 level triangle, masking the 8-bit steps.
    const float dither = (rnd(rng) + rnd(rng) - 1.0) / 255.0;
    imageStore(dst_img, p, vec4(clamp(outc + dither, vec3(0.0), vec3(1.0)), 1.0));
}
