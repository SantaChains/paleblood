// bbport present-path post pass 1: f3kdb/mpv-style deband plus fog removal, a shadow lift,
// contrast and saturation, with a dithered 8-bit write so smooth gradients survive the
// swapchain. The threshold is in 8-bit levels (mpv's realtime default is 0.75/255,
// libplacebo's 3/255; slider zero switches the merge off entirely); the range is the sample
// radius in pixels — the chain runs after the upscaler, so banding steps are upscale-wide
// and 16-24 suits a 2x stretch. The shadow lift is a multiplicative toe
// x * (1 + lift * (1-x)^2): near-black brightens, black stays black. Fog removal is the
// inverse of an even haze of intensity f: out = (x - f) / (1 - f). The source is read
// through a sampled-image descriptor, which per the Vulkan image-read rules returns
// RGBA-ordered values for BGRA formats; the rgba8 store then keeps that order and the
// final blit does the semantic conversion to the swapchain format.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D src_tex;
layout(binding = 1, rgba8) uniform writeonly image2D dst_img;

layout(push_constant) uniform Params {
    vec2 size;       // pixels
    float threshold; // 8-bit levels / 255
    float range;     // sample radius, pixels
    float lift;      // black lift, 0..1
    float defog;     // uniform haze intensity to subtract, 0..0.25
    float contrast;  // mid-grey pivot scale, 1 = neutral
    float saturation; // Rec.709 luma mix, 1 = neutral
    uint seed;       // per-frame RNG seed
    uint split;      // 1: left half passthrough (comparison debug view)
};

uint pcg(inout uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rnd(inout uint state) {
    return float(pcg(state)) / 4294967296.0;
}

vec3 FetchClamped(ivec2 p, vec2 offset, ivec2 hi) {
    return texelFetch(src_tex, clamp(ivec2(round(vec2(p) + offset)), ivec2(0), hi), 0).rgb;
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(size.x) || p.y >= int(size.y)) {
        return;
    }
    uint rng = uint(p.x) * 1973u ^ uint(p.y) * 9277u ^ seed;
    pcg(rng);
    pcg(rng);

    const vec3 c = texelFetch(src_tex, p, 0).rgb;
    // Comparison debug view: the left half is the untouched source pixel.
    if (split == 1u && p.x < int(size.x) / 2) {
        imageStore(dst_img, p, vec4(c, 1.0));
        return;
    }
    // Deband, mpv/libplacebo style (haasn's reference shader): one random direction and
    // distance, four taps at 90-degree rotations of that offset, and the 4-tap MEAN is merged
    // into the center per channel wherever it is inside the threshold. The mean-vs-center
    // test keeps single-tap outliers from bleeding texture detail; an all-or-nothing
    // per-pixel gate would not. Threshold 0 (no merging) skips the taps, so lift/defog stay
    // usable without debanding.
    vec3 outc = c;
    if (threshold > 0.0) {
        const float angle = rnd(rng) * 6.28318530718;
        const float dist = rnd(rng) * range;
        const vec2 d = vec2(cos(angle), sin(angle)) * dist;
        const ivec2 hi = ivec2(size) - 1;
        const vec3 mean = 0.25 * (FetchClamped(p, d, hi) + FetchClamped(p, vec2(-d.y, d.x), hi) +
                                  FetchClamped(p, -d, hi) + FetchClamped(p, vec2(d.y, -d.x), hi));
        outc = mix(mean, c, greaterThan(abs(mean - c), vec3(threshold)));
    }
    // Fog removal (levels black-point pull) before the lift, so both stack on clean blacks.
    outc = (outc - defog) / (1.0 - defog);
    // Multiplicative shadow toe: near-black brightens by up to (1 + lift), black stays black
    // (an additive pedestal would fog the black level; this is the "Shadows" grading move).
    outc *= 1.0 + lift * (1.0 - outc) * (1.0 - outc);
    // Contrast around mid-grey, then saturation away from Rec.709 luma.
    outc = (outc - 0.5) * contrast + 0.5;
    outc = mix(vec3(dot(outc, vec3(0.2126, 0.7152, 0.0722))), outc, saturation);
    // Triangular dither at HALF amplitude (+-0.5 level): pass 2 adds its own full +-1 level
    // dither, and the stacked noise must stay under ~1.5 LSB (libplacebo's ceiling).
    const float dither = (rnd(rng) + rnd(rng) - 1.0) / 510.0;
    imageStore(dst_img, p, vec4(clamp(outc + dither, vec3(0.0), vec3(1.0)), 1.0));
}
