// bbport present-path post pass 2: AMD RCAS (the FSR sharpening from the vendored ffx_fsr1.h,
// the same math as taa_sharpen.comp) on the debanded frame, with a dithered 8-bit write.
// Amount 0..1 maps onto RCAS's full strength range; the pass records only at a non-zero setting.
#version 450
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D src_tex;
layout(binding = 1, rgba8) uniform writeonly image2D dst_img;

layout(push_constant) uniform Params {
    vec2 size;    // pixels
    float amount; // 0..1
    uint seed;    // per-frame RNG seed
};

vec3 loadColor(ivec2 p) {
    return texelFetch(src_tex, clamp(p, ivec2(0), ivec2(size) - 1), 0).rgb;
}

uint pcg(inout uint state) {
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rnd(inout uint state) {
    return float(pcg(state)) / 4294967296.0;
}

#define A_GPU 1
#define A_GLSL 1
#include "fsr/ffx_a.h"
#define FSR_RCAS_F 1
#define FSR_RCAS_DENOISE 1
AF4 FsrRcasLoadF(ASU2 p) { return vec4(loadColor(ivec2(p)), 1); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "fsr/ffx_fsr1.h"

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(size.x) || p.y >= int(size.y)) {
        return;
    }
    const float a = clamp(amount, 0.0, 1.0);
    vec3 c = loadColor(p);
    // RCAS's approximate reciprocal can shift constant color; leave flat areas alone.
    const vec3 left = loadColor(p + ivec2(-1, 0)), right = loadColor(p + ivec2(1, 0));
    const vec3 top = loadColor(p + ivec2(0, -1)), bottom = loadColor(p + ivec2(0, 1));
    const vec3 peak = max(c, max(max(left, right), max(top, bottom)));
    const vec3 low = min(c, min(min(left, right), min(top, bottom)));
    if (all(lessThanEqual(peak - low, vec3(1e-6)))) {
        imageStore(dst_img, p, vec4(c, 1.0));
        return;
    }
    const uvec4 constants = uvec4(floatBitsToUint(exp2(-2.0 * (1.0 - a))), 0u, 0u, 0u);
    vec3 sharpened;
    FsrRcasF(sharpened.r, sharpened.g, sharpened.b, uvec2(p), constants);
    uint rng = uint(p.x) * 1973u ^ uint(p.y) * 9277u ^ seed;
    pcg(rng);
    pcg(rng);
    const float dither = (rnd(rng) + rnd(rng) - 1.0) / 255.0;
    imageStore(dst_img, p, vec4(clamp(sharpened + dither, vec3(0.0), vec3(1.0)), 1.0));
}
